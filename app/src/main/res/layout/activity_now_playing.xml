<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_now_playing">

<LinearLayout
    android:id="@+id/npMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_expand_down"
        app:title=""
        app:titleCentered="true"
        app:titleTextAppearance="?attr/textAppearanceLabelLarge">

        <!-- 🎧 音声だけ / ▶ 動画(オンラインの曲で動画がある時だけ) -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/avToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/avAudio"
                style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                android:layout_width="52dp"
                android:layout_height="40dp"
                android:contentDescription="音声だけ"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="16dp"
                app:icon="@drawable/ic_music"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/avVideo"
                style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                android:layout_width="52dp"
                android:layout_height="40dp"
                android:contentDescription="動画"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="16dp"
                app:icon="@drawable/ic_movie"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- 何から再生しているか(タップでそのプレイリストへ)。上のバーが窮屈にならないよう 1 段下に -->
    <TextView
        android:id="@+id/npSource"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:background="?attr/selectableItemBackground"
        android:ellipsize="end"
        android:gravity="center"
        android:paddingVertical="4dp"
        android:singleLine="true"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

    <!-- ジャケット / 歌詞(切り替え)。動画を映す時は左右の余白をなくして画面の横幅いっぱいに(コードで切り替え) -->
    <FrameLayout
        android:id="@+id/npArtBox"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Large" />

        <!-- ▶ 動画モードの映像(ジャケットの場所に) -->
        <FrameLayout
            android:id="@+id/npVideoBox"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <androidx.media3.ui.PlayerView
                android:id="@+id/npVideo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:resize_mode="fit"
                app:surface_type="texture_view"
                app:shutter_background_color="@android:color/transparent"
                app:show_buffering="never"
                app:use_controller="false" />

            <!-- 新しい動画の最初の 1 コマが出るまではジャケットで隠す(前の曲の最後のコマが見えないように) -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/npVideoCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Large" />

            <ImageButton
                android:id="@+id/npRotate"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="56dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_fs_button"
                android:contentDescription="画面の回転"
                android:src="@drawable/ic_screen_rotation" />

            <ImageButton
                android:id="@+id/npFullscreen"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="6dp"
                android:background="@drawable/bg_fs_button"
                android:contentDescription="全画面で見る"
                android:src="@drawable/ic_fullscreen" />
        </FrameLayout>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/npLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/lyricsScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fadingEdgeLength="48dp"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/lyricsBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="120dp" />
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

    <!-- 曲名・アーティスト + ♡ / ダウンロード(曲に対する操作は曲名の横に) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceHeadlineSmall" />

            <TextView
                android:id="@+id/artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <!-- アルバム名(タップで検索) -->
            <TextView
                android:id="@+id/album"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?android:attr/textColorSecondary"
                android:visibility="gone" />

            <!-- この曲のダウンロード(音声・動画)の進み具合 -->
            <TextView
                android:id="@+id/npDlProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorPrimary"
                android:visibility="gone" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/likeBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="お気に入り"
            android:src="@drawable/ic_favorite_border"
            android:visibility="gone" />

        <!-- No Good(おすすめ・ラジオに出さない)。誤タッチしないよう少し離す -->
        <ImageButton
            android:id="@+id/noGoodBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="No Good"
            android:src="@drawable/ic_thumb_down_outline"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/downloadBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="この曲をダウンロード"
            android:src="@drawable/ic_download"
            android:visibility="gone" />
    </LinearLayout>

    <com.google.android.material.chip.Chip
        android:id="@+id/sleepChip"
        style="@style/Widget.Material3.Chip.Assist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:chipIcon="@drawable/ic_bedtime"
        app:chipIconTint="?attr/colorPrimary" />

    <com.google.android.material.slider.Slider
        android:id="@+id/seek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:valueFrom="0"
        android:valueTo="1"
        app:labelBehavior="gone"
        app:trackStopIndicatorSize="0dp"
        app:thumbTrackGapSize="0dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="32dp">

        <TextView
            android:id="@+id/pos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0:00"
            android:textAppearance="?attr/textAppearanceLabelSmall" />

        <TextView
            android:id="@+id/dur"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textAppearance="?attr/textAppearanceLabelSmall" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/shuffle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="シャッフル"
            android:src="@drawable/ic_shuffle" />

        <ImageButton
            android:id="@+id/prev"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="前の曲"
            android:scaleType="center"
            android:src="@drawable/ic_skip_prev" />

        <!-- 再生ボタン。読み込みに時間がかかっている時は周りがくるくる回る -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/playPause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="6dp"
                android:contentDescription="再生/一時停止"
                android:src="@drawable/ic_play"
                app:fabSize="normal" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/playLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:elevation="24dp"
                android:indeterminate="true"
                android:visibility="invisible"
                app:indicatorSize="68dp"
                app:trackThickness="3dp"
                app:showDelay="300"
                app:minHideDelay="300" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/next"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="次の曲"
            android:scaleType="center"
            android:src="@drawable/ic_skip_next" />

        <ImageButton
            android:id="@+id/repeat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="リピート"
            android:src="@drawable/ic_repeat" />
    </LinearLayout>

    <!-- 次の曲(タップ / 上にスワイプで再生キュー) -->
    <TextView
        android:id="@+id/upNext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:ellipsize="end"
        android:gravity="center"
        android:paddingHorizontal="32dp"
        android:paddingVertical="6dp"
        android:singleLine="true"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <!-- よく切り替えるものは指の届く画面下に、文字付きで -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <LinearLayout
            android:id="@+id/actLyrics"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <ImageView
                android:id="@+id/actLyricsIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_lyrics"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/actLyricsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxWidth="88dp"
                android:singleLine="true"
                android:text="歌詞"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/actQueue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <ImageView
                android:id="@+id/actQueueIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_queue_music"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/actQueueLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxWidth="88dp"
                android:singleLine="true"
                android:text="再生キュー"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/actRadio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <ImageView
                android:id="@+id/actRadioIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_autoplay"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/actRadioLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxWidth="88dp"
                android:singleLine="true"
                android:text="ラジオ"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/actSleep"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <ImageView
                android:id="@+id/actSleepIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_bedtime"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/actSleepLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxWidth="88dp"
                android:singleLine="true"
                android:text="タイマー"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

    <!-- 横向きの全画面動画(🎬 の時だけ) -->
    <FrameLayout
        android:id="@+id/fsBox"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:visibility="gone">

        <androidx.media3.ui.PlayerView
            android:id="@+id/fsVideo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="fit"
            app:surface_type="texture_view"
            app:show_buffering="when_playing"
            app:use_controller="true" />

        <!-- 全画面で操作パネルが出ている間だけ: 再生ボタンの下に ♡ お気に入り / 👎 No Good -->
        <LinearLayout
            android:id="@+id/fsActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="120dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/fsLike"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/bg_fs_button"
                android:contentDescription="お気に入りに追加"
                android:src="@drawable/ic_favorite_border" />

            <ImageButton
                android:id="@+id/fsNoGood"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_fs_button"
                android:contentDescription="No Good"
                android:src="@drawable/ic_thumb_down_outline" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/fsRotate"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_fs_button"
                android:contentDescription="画面の回転"
                android:src="@drawable/ic_screen_rotation" />

            <ImageButton
                android:id="@+id/fsExit"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_fs_button"
                android:contentDescription="全画面をやめる"
                android:src="@drawable/ic_fullscreen_exit" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
